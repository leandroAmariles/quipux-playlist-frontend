map $request_uri $api_path {
    default "";
    ~^/api(?<api_rest>/.*)$ $api_rest;
}

server {
    listen 8080;
    absolute_redirect off;
    root /usr/share/nginx/html;
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    location /api/ {
        set $api_url ${API_URL};
        if ($api_path = "") {
            return 404;
        }
        proxy_pass $api_url$api_path;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_redirect off;
    }

    location / {
        try_files $uri /index.html;
    }
}
